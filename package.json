{
  "name": "organic-soap-builder",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter @lotr/app dev",
    "dev:api": "bun run --filter @lotr/api dev",
    "dev:all": "bun run dev & bun run dev:api",
    "build": "bun run --filter @lotr/app build",
    "preview": "bun run --filter @lotr/app preview",
    "lint": "bun run --filter @lotr/app lint",
    "format": "bun run --filter @lotr/app format",
    "format:check": "bun run --filter @lotr/app format:check",
    "test": "bun run --filter @lotr/app test",
    "test:api": "bun run --filter @lotr/api test",
    "test:all": "bun run --filter '*' test",
    "test:e2e": "bun run --filter @lotr/app test:e2e",
    "test:ui": "bun run --filter @lotr/app test:ui",
    "test:watch": "bun run --filter @lotr/app test:watch",
    "test:coverage": "bun run --filter @lotr/app test:coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/node": "^22.14.0",
    "typescript": "~5.8.2",
    "vitest": "^4.1.6"
  }
}
