{
  "name": "organic-soap-builder",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter @lotr/app dev",
    "dev:api": "bun run --filter @lotr/api dev",
    "dev:all": "bun run dev & bun run dev:api",
    "build": "bun run --filter @lotr/app build",
    "preview": "bun run --filter @lotr/app preview",
    "lint": "bun run --filter @lotr/app lint",
    "format": "bun run --filter @lotr/app format",
    "format:check": "bun run --filter @lotr/app format:check",
    "test": "bun run --filter @lotr/app test",
    "test:api": "bun run --filter @lotr/api test",
    "test:all": "bun run --filter '*' test",
    "test:e2e": "bun run --filter @lotr/app test:e2e",
    "test:ui": "bun run --filter @lotr/app test:ui",
    "test:watch": "bun run --filter @lotr/app test:watch",
    "test:coverage": "bun run --filter @lotr/app test:coverage"
  },
  "dependencies": {
    "@libsql/client": "^0.17.3",
    "@tabler/icons-react": "^3.44.0",
    "@tanstack/react-query": "^5.100.11",
    "@tanstack/react-query-devtools": "^5.100.11",
    "@tanstack/react-router": "^1.170.4",
    "@tanstack/router-vite-plugin": "^1.167.6",
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.6",
    "autoprefixer": "^10.4.23",
    "happy-dom": "^20.9.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.57.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "^4.1.6"
  }
}
