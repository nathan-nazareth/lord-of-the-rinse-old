# App-side environment variables
# IMPORTANT: Never commit actual values to version control!
# Copy this file to .env.local and fill in the actual values

# Admin backend URL (your backend server URL)
VITE_ADMIN_BACKEND_URL=http://localhost:3001

# Catalog API base URL. Leave empty in production to use same-origin
# requests (requires Vercel rewrites /api/* to your API service).
# In dev, the Vite proxy handles /api/* -> http://localhost:3001.
# The Web3Forms access key is configured server-side via
# WEB3FORMS_ACCESS_KEY in packages/api/.env and proxied through
# /api/webhook-submit; never put a real access key in this file.
