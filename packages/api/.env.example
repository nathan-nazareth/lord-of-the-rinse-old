# @lotr/api environment variables
PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lotr

# Better Auth
BETTER_AUTH_SECRET=  # Generate with: openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3001

# CORS
CORS_ORIGIN=http://localhost:3000

# Admin Panel
# Must be at least 16 characters. Generate with: openssl rand -base64 24
ADMIN_PASSWORD=
# Token signing secret (HS256). Generate with: openssl rand -base64 32
ADMIN_TOKEN_SECRET=
ADMIN_SQLITE_URL=file:admin.db

# Web3Forms (https://web3forms.com/) — access key for order notifications
WEB3FORMS_ACCESS_KEY=
