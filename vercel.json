{
  "framework": "vite",
  "installCommand": "cd packages/app && npm install --no-workspaces",
  "buildCommand": "cd packages/app && npm run build",
  "outputDirectory": "packages/app/dist",
  "routes": [
    { "src": "/api/test", "dest": "/api/test/index.cjs" },
    { "src": "/api/admin/auth/login", "dest": "/api/admin/auth/login/index.cjs" },
    { "src": "/api/admin/products", "dest": "/api/admin/products/index.cjs" },
    { "src": "/api/admin/options", "dest": "/api/admin/options/index.cjs" },
    { "src": "/api/admin/discounts", "dest": "/api/admin/discounts/index.cjs" },
    { "src": "/admin/?$", "dest": "/index.html" },
    { "src": "/admin/(.*)", "dest": "/index.html" },
    { "src": "/cart/?$", "dest": "/index.html" },
    { "src": "/cart/(.*)", "dest": "/index.html" },
    { "src": "/checkout/?$", "dest": "/index.html" },
    { "src": "/checkout/(.*)", "dest": "/index.html" }
  ]
}